# Contact form email delivery — copy to .env.local and fill in values.
# Prefer ONE of: Resend OR Gmail SMTP.

# --- Option A: Resend (recommended for production) ---
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_FROM_EMAIL="Torix Solutions <onboarding@resend.dev>"
# After verifying your domain in Resend, use e.g.:
# CONTACT_FROM_EMAIL="Torix Solutions <noreply@torixhealth.com>"

# --- Option B: Gmail SMTP (works with a Gmail inbox) ---
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where form submissions are delivered (defaults to contact@torixsolutions.com)
CONTACT_TO_EMAIL=yourname@gmail.com

# Optional public site URL override
# NEXT_PUBLIC_SITE_URL=https://www.torixhealth.com
